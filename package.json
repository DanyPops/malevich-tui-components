{
  "name": "malevich-tui-components",
  "version": "0.31.1",
  "description": "A headless, renderer-agnostic TUI component library: layout and interaction algorithms only. Color, text measurement, key semantics, and terminal compositing are all host-supplied ports; components run unmodified against any host matching the Component/Focusable shape (Pi's own pi-tui, Alef's alef-tui, or others).",
  "type": "module",
  "license": "MIT",
  "keywords": ["tui", "terminal", "ui", "components", "cli"],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "files": ["src", "dist", "README.md", "LICENSE"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "test": "bun test",
    "check": "bun x tsc --noEmit",
    "build": "bun x tsc -p tsconfig.build.json",
    "format": "biome format --write .",
    "lint": "biome check --write . && eslint src test --max-warnings 0",
    "lint:ci": "biome ci . && eslint src test --max-warnings 0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@danypops/pi-tui-harness": "^0.0.1",
    "@earendil-works/pi-tui": "^0.82.1",
    "@types/node": "^22.19.19",
    "bun-types": "^1.3.14",
    "eslint": "^10.8.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "jiti": "^2.7.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DanyPops/malevich-tui-components.git"
  },
  "trustedDependencies": [
    "unrs-resolver"
  ]
}
